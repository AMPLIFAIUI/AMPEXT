{
  "manifest_version": 3,
  "name": "AMP - Auto Memory Persistence",
  "version": "4.0.0",
  "description": "Infinite context memory system for AI conversations",
  
  "icons": {
    "32": "icon32.png",
    "48": "icon48.png",
    "64": "icon64.png",
    "128": "icon128.png",
    "256": "icon256.png"
  },
  
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "unlimitedStorage",
    "windows",
    "nativeMessaging",
    "notifications"
  ],
  
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*",
    "https://character.ai/*",
    "https://you.com/*",
    "https://blackbox.ai/*",
    "https://www.blackbox.ai/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*",
        "https://character.ai/*",
        "https://you.com/*",
        "https://blackbox.ai/*",
        "https://www.blackbox.ai/*"
      ],
      "js": ["utils.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  
  "action": {
    "default_popup": "dropdown.html",
    "default_title": "AMP Memory",
    "default_icon": "icon48.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["utils.js", "amp-ui.html", "zipper-viewer.js", "animated logo/*"],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*",
        "https://character.ai/*",
        "https://you.com/*",
        "https://blackbox.ai/*",
        "https://www.blackbox.ai/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
} 